# DriftBrief - Variables de Entorno
# Copia este archivo como .env y agrega tus claves.
# IMPORTANTE: Las variables VITE_* se exponen en el bundle del cliente.
# Para producción con keys reales, usar un proxy server-side.

# Google Gemini API (opcional - fallback a motor local si no está configurada)
VITE_GEMINI_API_KEY=

# Groq API (opcional - segundo fallback antes del motor local)
VITE_GROQ_API_KEY=
