{
  "version": "1.0.0",
  "enabled": true,
  "name": "Secret Scanner on Agent Stop",
  "description": "Escanea silenciosamente al finalizar el turno del agente para verificar que no hayan quedado claves de API expuestas.",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Escanea todo el código recién generado o modificado para asegurar que no contenga API keys de Google Gemini (AIzaSy...), Groq (gsk_...) ni credenciales en texto plano de acuerdo con .kiro/steering/security-rules.md. Si encuentras secretos, reporta qué archivos los contienen y qué líneas, pero NO bloques la ejecución."
  }
}
